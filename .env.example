# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://titan:password@localhost:5432/titan_hub"

# ─────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────
JWT_SECRET="change-me-to-a-secure-random-string-min-32-chars"
JWT_EXPIRES_IN="7d"

# ─────────────────────────────────────────────
# API
# ─────────────────────────────────────────────
API_PORT=3001
API_URL="https://titanpos.ru/api"
FRONTEND_URL="https://titanpos.ru"

# ─────────────────────────────────────────────
# MinIO (file storage)
# ─────────────────────────────────────────────
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="titan-hub"
MINIO_PUBLIC_URL="https://titanpos.ru/media"

# ─────────────────────────────────────────────
# Telegram — шлюз для сервера в РФ (infra/telegram-relay)
# ─────────────────────────────────────────────
# api.telegram.org из РФ недоступен. Пусто = прямой адрес.
# TELEGRAM_API_ROOT="https://tg.titanpos.ru/<RELAY_KEY>"
# Хост, на который Telegram шлёт вебхук бота опросов (шлюз пересылает на ROOT_DOMAIN).
# TELEGRAM_WEBHOOK_HOST="tg.titanpos.ru"
# 1 = не запускать фоновые задачи (пробный запуск на копии БД).
# CRON_DISABLED="1"

# ─────────────────────────────────────────────
# MafBoard — сервер приложения для ведущих мафии (docs/MAFBOARD.md)
# ─────────────────────────────────────────────
# Без MAFBOARD_DATABASE_URL и MAFBOARD_JWT_SECRET модуль выключен (ручки → 503).
# В docker-compose MAFBOARD_DATABASE_URL уже задан (БД mafboard создаётся сама).
# MAFBOARD_DATABASE_URL="postgresql://titan:<пароль>@postgres:5432/mafboard"
# Свой ключ токенов приложения (не JWT_SECRET), ≥ 32 символов: openssl rand -base64 48
# MAFBOARD_JWT_SECRET=""
# Токен бота входа MafBoard от @BotFather. Только здесь — никогда в коде и в приложении.
# MAFBOARD_BOT_TOKEN=""
# Username бота без «@» (если пусто — берётся из getMe).
# MAFBOARD_BOT_USERNAME=""
# Домен Universal Link приложения: бот возвращает на <домен>/auth/return?ticket=…
# MAFBOARD_APP_LINK_BASE="https://mafboard.titanpos.ru"
# Пользовательское соглашение и его версия (смена версии — бот попросит принять заново).
# MAFBOARD_TERMS_URL="https://mafboard.titanpos.ru/terms"
# MAFBOARD_TERMS_VERSION="1"
# Пароль входа проверяющего App Store (логин appreview), ≥ 16 символов; пусто — вход выключен.
# MAFBOARD_REVIEW_PASSWORD=""

# ─────────────────────────────────────────────
# Telegram — Admin Bot
# ─────────────────────────────────────────────
# Боты HUB и Wallet упразднены (2026-10-12): весь Telegram — бот Tai, токен в «Интеграциях» (poll_bot_token).
# Переменные ниже нужны только для входа старых Telegram Mini App и могут быть пустыми.
ADMIN_BOT_TOKEN=""
ADMIN_CHAT_ID=""
# Telegram id (через запятую), которым разрешён доступ к админ-боту.
# Пусто = доступ любому owner/staff с привязанным tgId.
ADMIN_TG_IDS=""

# ─────────────────────────────────────────────
# Telegram — Wallet Bot
# ─────────────────────────────────────────────
WALLET_BOT_TOKEN=""
WALLET_WEBAPP_URL="https://titanpos.ru/wallet"
# username бота-кошелька (без @), для сборки t.me диплинков привязки клиента
WALLET_BOT_USERNAME=""

# ─────────────────────────────────────────────
# Push на iPhone — приложение My Titan (APNs напрямую)
# ─────────────────────────────────────────────
# Ключ APNs команды Apple (AuthKey_<KEY_ID>.p8): base64 от файла или PEM с \n.
# Пусто = push на iPhone не уходят; лента в приложении и бот работают.
APNS_KEY_P8=""
APNS_KEY_ID=""
APNS_TEAM_ID=""
# bundle id приложения
APNS_TOPIC="ru.titan.resident"

# ─────────────────────────────────────────────
# Anthropic AI
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-4-6"

# ─────────────────────────────────────────────
# Platega — SBP QR payments
# ─────────────────────────────────────────────
PLATEGA_MERCHANT_ID=""
PLATEGA_SECRET=""

# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
NODE_ENV="production"
APP_VERSION="1.0.0"
